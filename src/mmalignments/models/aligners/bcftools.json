      "render": "flag",
      "description": "Print only the header in VCF output."
    },
    "no_header": {
      "flag": "-H",
      "dtype": [
        "bool"
      ],
      "default": false,
      "required": false,
      "affects_output": true,
      "render": "flag",
      "description": "Suppress the header in VCF output."
